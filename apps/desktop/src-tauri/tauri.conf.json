{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SCIP",
  "version": "0.2.0",
  "identifier": "com.scip.desktop",
  "build": {
    "frontendDist": "../web-dist",
    "beforeBuildCommand": "node scripts/stage-all.mjs web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SCIP",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "backgroundColor": "#e3e4e6",
        "url": "splash/index.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: http://127.0.0.1:*; media-src 'self' blob: https: http:; font-src 'self' data:; worker-src 'self' blob:; child-src 'self' blob:; frame-src https:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:* https: wss:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/": "resources/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French",
          "English"
        ]
      }
    }
  }
}
