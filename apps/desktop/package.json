{
  "name": "@scip/desktop",
  "version": "0.2.0",
  "private": true,
  "description": "SCIP Windows desktop shell (Tauri 2) and process supervisor",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "build:debug": "tauri build --debug",
    "icons": "tauri icon src-tauri/icons/source.svg --output src-tauri/icons",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "lint": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "stage": "node scripts/stage-all.mjs",
    "installer-art": "node scripts/render-installer-art.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0"
  }
}
