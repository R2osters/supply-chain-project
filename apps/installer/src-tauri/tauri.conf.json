{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SCIP Setup",
  "version": "0.2.1",
  "identifier": "com.scip.setup",
  "mainBinaryName": "scip-installer",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Installation de SCIP",
        "width": 960,
        "height": 640,
        "center": true,
        "resizable": false,
        "maximizable": false,
        "decorations": true,
        "backgroundColor": "#e3e4e6",
        "url": "index.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "SCIP",
    "copyright": "SCIP · Supply Chain Intelligence Platform",
    "shortDescription": "Installation de SCIP"
  }
}
