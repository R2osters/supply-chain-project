# ---------------------------------------------------------------------------
# SCIP — copy to .env and adjust. Never commit .env.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Database ---------------------------------------------------------------
POSTGRES_USER=scip
POSTGRES_PASSWORD=scip_dev_password_change_me
POSTGRES_DB=scip
POSTGRES_PORT=5433
# Used by the API (host access). Inside docker-compose the host becomes "postgres".
DATABASE_URL=postgresql://scip:scip_dev_password_change_me@localhost:5433/scip?schema=public

# --- Redis ------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

# --- API --------------------------------------------------------------------
API_PORT=3001
API_GLOBAL_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000

# --- Auth -------------------------------------------------------------------
# CHANGE BOTH IN ANY NON-LOCAL ENVIRONMENT. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev_only_access_secret_replace_me_0000000000000000
JWT_REFRESH_SECRET=dev_only_refresh_secret_replace_me_000000000000000
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
ARGON2_MEMORY_COST=19456
PASSWORD_RESET_TTL_MINUTES=30

# --- Rate limiting ----------------------------------------------------------
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
THROTTLE_AUTH_LIMIT=10

# --- AI service -------------------------------------------------------------
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=30000
AI_SERVICE_TOKEN=dev_only_ai_shared_token_replace_me

# --- Object storage (MinIO / any S3) ---------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=scip-pod
S3_ACCESS_KEY=scipminio
S3_SECRET_KEY=scipminio_dev_password
S3_FORCE_PATH_STYLE=true

# --- Email (MailHog locally: UI on http://localhost:8025) -------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="SCIP <no-reply@scip.local>"

# --- External providers -----------------------------------------------------
# All optional. Left empty => the deterministic, clearly-labelled stub is used.
OPENWEATHER_API_KEY=
OSRM_URL=
# Road distance = haversine * this factor when no OSRM server is configured.
ROAD_WINDING_FACTOR=1.25

# --- Telemetry simulator (DEMO DATA) ---------------------------------------
SIMULATOR_ENABLED=true
SIMULATOR_TICK_MS=5000
# Time compression. At 60 a 5-hour trip finishes in 5 minutes, which empties the live map
# during a demo; 12 keeps vehicles visibly moving while a 5-hour corridor still takes ~25 min.
SIMULATOR_SPEED_MULTIPLIER=12

# --- Frontend ---------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:3001
# Any MapLibre-compatible style. Default below needs no API key.
NEXT_PUBLIC_MAP_STYLE_URL=
