# ---------------------------------------------------------------------------
# SCIP — copy to .env and adjust. Never commit .env.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Database ---------------------------------------------------------------
POSTGRES_USER=scip
POSTGRES_PASSWORD=scip_dev_password_change_me
POSTGRES_DB=scip
POSTGRES_PORT=5433
# Used by the API (host access). Inside docker-compose the host becomes "postgres".
DATABASE_URL=postgresql://scip:scip_dev_password_change_me@localhost:5433/scip?schema=public

# --- Redis ------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

# --- API --------------------------------------------------------------------
API_PORT=3001
API_GLOBAL_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000

# --- Auth -------------------------------------------------------------------
# CHANGE BOTH IN ANY NON-LOCAL ENVIRONMENT. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev_only_access_secret_replace_me_0000000000000000
JWT_REFRESH_SECRET=dev_only_refresh_secret_replace_me_000000000000000
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
ARGON2_MEMORY_COST=19456
PASSWORD_RESET_TTL_MINUTES=30

# --- Rate limiting ----------------------------------------------------------
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
THROTTLE_AUTH_LIMIT=10

# --- AI service -------------------------------------------------------------
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=30000
AI_SERVICE_TOKEN=dev_only_ai_shared_token_replace_me

# --- Object storage (MinIO / any S3) ---------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=scip-pod
S3_ACCESS_KEY=scipminio
S3_SECRET_KEY=scipminio_dev_password
S3_FORCE_PATH_STYLE=true

# --- Email (MailHog locally: UI on http://localhost:8025) -------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="SCIP <no-reply@scip.local>"

# --- External providers -----------------------------------------------------
# All optional. Left empty => the deterministic, clearly-labelled stub is used.
OSRM_URL=
# Road distance = haversine * this factor when no OSRM server is configured.
ROAD_WINDING_FACTOR=1.25

# --- Telemetry simulator (DEMO DATA) ---------------------------------------
SIMULATOR_ENABLED=true
SIMULATOR_TICK_MS=5000
# Time compression. At 60 a 5-hour trip finishes in 5 minutes, which empties the live map
# during a demo; 12 keeps vehicles visibly moving while a 5-hour corridor still takes ~25 min.
SIMULATOR_SPEED_MULTIPLIER=12

# --- Hardware GPS trackers --------------------------------------------------
# TCP listener for GT06/Concox trackers — the €15-50 devices sold under a hundred brand names.
# They speak a binary protocol over a raw socket, not HTTP, so this is a separate port.
# Point a device at it by SMS:  server#<your-public-host>#5023#
# 5023 matches Traccar's GT06 port, so a device already configured for Traccar needs no changes.
DEVICE_GATEWAY_ENABLED=true
DEVICE_GATEWAY_PORT=5023

# --- Maritime / AIS ---------------------------------------------------------
# Free key at https://aisstream.io — vessel positions then come live from the ships'
# own AIS broadcasts. Leave empty and voyages are simulated along great-circle tracks,
# with every position stored as source=SIMULATOR and badged in the UI.
AISSTREAM_API_KEY=
# Optional: limit the subscription to regions you care about. A worldwide feed is tens of
# thousands of messages a minute, nearly all for vessels you do not track.
# Format: "lat1,lon1,lat2,lon2;lat1,lon1,lat2,lon2"
# Example below covers the North Atlantic and the Gulf of Guinea.
AIS_BOUNDING_BOXES=

# MarineTraffic. PAID — their API has no free tier and is priced per credit. Worth it for one
# reason: they fuse *satellite* AIS, so a ship mid-Atlantic still reports. Terrestrial receivers
# reach ~40–60 nautical miles offshore and a vessel simply vanishes beyond that.
# When set, this takes precedence over AISSTREAM_API_KEY. Only one source ever runs — mixing feeds
# for the same vessel produces a track whose points disagree about where it was.
MARINETRAFFIC_API_KEY=
# Each poll costs credits per vessel. A ship at 18 knots moves 1.5 nm in five minutes.
MARINETRAFFIC_POLL_SECONDS=300
# Embeds MarineTraffic's live map inside the vessel screen. OFF by default: embedding a third
# party's map is governed by THEIR terms of service, which is an operator's decision, not a code
# default. Deep links to their public vessel pages carry no such question and are always enabled.
MARINETRAFFIC_EMBED_ENABLED=false

# --- Situational feeds (hazards, cameras, radio, satellites, traffic) --------
# Cyclones (NOAA NHC), earthquakes (USGS), weather (Open-Meteo), news (GDELT), public cameras,
# radio stations (Radio Browser), satellites (CelesTrak) and geocoding (Photon/Nominatim) need
# no key. Each source's licence and attribution are listed in docs/INTEL.md.
# NASA FIRMS active fires. Free: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
# TomTom live traffic-flow tiles on the live map. Free tier: https://developer.tomtom.com
TOMTOM_API_KEY=
# Our own daily ceiling, below TomTom's allowance, so a runaway map stops before the bill does.
TOMTOM_DAILY_TILE_BUDGET=6000
# Public camera catalogues to load: tfl, fintraffic, drivebc, nsw, calgary. (ontario511 exists
# but its catalogue now answers "Invalid Key" without a developer key, so it is off by default.)
CAMERA_PACKS=tfl,fintraffic,drivebc,nsw,calgary
# A hazard within this distance of a warehouse or active shipment counts as exposure.
HAZARD_EXPOSURE_RADIUS_KM=150

# --- Frontend ---------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:3001
# Any MapLibre-compatible style. Default below needs no API key.
NEXT_PUBLIC_MAP_STYLE_URL=
